<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Chapter 14: Not Just Words Anymore

        This module extends Sarah's shopping assistant to accept an image
        alongside a text question, using Spring AI's multimodal ChatClient
        support. A customer can upload a photo of a shoe and ask whether
        Acme Retail carries it in another color; the vision-capable model
        describes what it sees and the response is grounded against Acme
        Retail's real category and color vocabulary, the same discipline
        Chapter 11 established for text-only grounding.

        This module is self-contained and independently runnable. It is not
        wired into any other chapter's build.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail</groupId>
    <artifactId>chapter-14-not-just-words-anymore</artifactId>
    <version>1.0.0</version>
    <name>chapter-14-not-just-words-anymore</name>
    <description>
        Java AI Engineer: Sarah's Journey at Acme Retail.
        Chapter 14: multimodal AI -- accepting an image alongside text with
        Spring AI's ChatClient, and grounding the response in real catalog
        vocabulary instead of letting the model invent a match.
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            The OpenAI starter also auto-configures multimodal support: the
            same ChatClient bean that handles text-only prompts (Chapter 10)
            can accept an image attached to a user message, as long as the
            configured model is vision-capable (for example, gpt-4o).
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
