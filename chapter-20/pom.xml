<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Chapter 20, Launch Day

        This module is self-contained and independently runnable. It is not
        wired into any other chapter's build. Each chapter of this book gets
        its own Maven module so a reader can open exactly one chapter's code
        without pulling in the rest of the book.

        Story: Acme Retail launches the shopping assistant publicly. On launch
        day an alert fires. This module is the capstone, the one place
        in the book where resilience (Chapter 16's circuit breaker and
        fallback), observability (Chapter 17's structured logs, correlation
        IDs and metrics) and AI evaluation (Chapter 19's golden dataset) work
        together inside a single incident-response flow, instead of being
        demonstrated one at a time.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail</groupId>
    <artifactId>chapter-20-launch-day</artifactId>
    <version>1.0.0</version>
    <name>chapter-20-launch-day</name>
    <description>
        Java AI Engineer -- Sarah's Journey at Acme Retail.
        Chapter 20: an end-to-end incident-response flow for the AI shopping
        assistant, combining a circuit breaker with fallback, structured
        logging with correlation IDs, request metrics, and a golden-dataset
        evaluation gate that must pass before a fix is allowed to re-enable
        the assistant feature flag.
    </description>

    <properties>
        <java.version>21</java.version>
        <resilience4j.version>2.2.0</resilience4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                This chapter's tests use Mockito (@MockBean / Mockito.mock),
                which needs to instrument classes at runtime. On JDK versions
                newer than what this Spring Boot version's pinned Byte Buddy
                officially supports, and in environments that restrict a JVM
                from self-attaching its own instrumentation agent, Mockito's
                inline mock maker otherwise fails to initialize. Pre-loading
                the agent explicitly (rather than relying on self-attach) and
                allowing Byte Buddy's experimental newer-JDK support keeps
                these tests running on any JDK 21+ without changing any
                dependency versions.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
