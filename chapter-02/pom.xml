<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Chapter 02 — "It Works, But It's Slow"

        Standalone module. It does not depend on chapter-01. It simulates the
        same shape of problem Sarah hits in production: a product API whose
        requests block on a slow downstream call (standing in for the database
        round trip that chapter 03 examines in detail).

        Run it with:
          mvn spring-boot:run

        Run the tests (including the small in-process "load test") with:
          mvn test
    -->

    <groupId>com.acme.retail</groupId>
    <artifactId>ch02-product-api</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Chapter 02 - It Works, But It's Slow</name>
    <description>
        Product API that reproduces Sarah's concurrency problem: blocking I/O
        under load, first "fixed" by tuning the platform-thread pool, then
        properly fixed with Java 21 virtual threads.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ch02-product-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
