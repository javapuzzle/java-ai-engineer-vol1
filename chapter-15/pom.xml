<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Chapter 15: Sarah Builds an Escape Hatch

        Chapter 09 established the architectural principle: depend on Spring
        AI's portable ChatClient interface, not a specific vendor's SDK, so a
        provider is a configuration detail rather than a hardcoded fact. This
        module puts that principle to an actual test: two provider starters
        (OpenAI and Anthropic) are configured simultaneously as distinct,
        qualified beans, and a small resilience layer automatically falls
        back from the primary provider to the secondary one at runtime,
        proving the "we could switch providers" claim instead of just making it.

        This module is self-contained and independently runnable. It is not
        wired into any other chapter's build.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.acme.retail</groupId>
    <artifactId>chapter-15-sarah-builds-an-escape-hatch</artifactId>
    <version>1.0.0</version>
    <name>chapter-15-sarah-builds-an-escape-hatch</name>
    <description>
        Java AI Engineer: Sarah's Journey at Acme Retail.
        Chapter 15: model portability -- two AI providers configured
        simultaneously as distinct beans, with an automatic runtime fallback
        from the primary provider to the secondary one.
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Primary provider. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            Fallback provider. Having two provider starters on the classpath
            at once is exactly the situation Chapter 09 warned could cause
            ambiguous auto-configuration; this module resolves that by
            explicitly qualifying each ChatClient bean by name, rather than
            leaving Spring to guess which one is "the" ChatClient.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                This chapter's tests use Mockito (@MockBean / Mockito.mock),
                which needs to instrument classes at runtime. On JDK versions
                newer than what this Spring Boot version's pinned Byte Buddy
                officially supports, and in environments that restrict a JVM
                from self-attaching its own instrumentation agent, Mockito's
                inline mock maker otherwise fails to initialize. Pre-loading
                the agent explicitly (rather than relying on self-attach) and
                allowing Byte Buddy's experimental newer-JDK support keeps
                these tests running on any JDK 21+ without changing any
                dependency versions.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
